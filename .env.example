HDGIP1="your_hdgip1_address"
HDGIP2="your_hdgip2_address"
SUPABASE_URL="your_supabase_url"
SUPABASE_KEY="your_supabase_key"
CAMERA="rtsp://USERNAME:PASSWORD@IP_ADRESSE:PORT"

# Optional: QUNDIS Q log 5.5
QLOG_ADDRESS="<QLOG-BLUETOOTH-MAC>"
QLOG_CHANNEL="5"
SUPABASE_HEATING_TABLE="heating_meter_readings"

# Optional: Fronius PV → public.pv_readings (one or many IPs)
FRONIUS_IPS="<FRONIUS-IP-1>,<FRONIUS-IP-2>"
FRONIUS_READING_HOUR="23"
SUPABASE_PV_TABLE="pv_readings"
